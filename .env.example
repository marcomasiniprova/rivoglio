# Le chiavi vive stanno in .env.development.local (NON in .env.local: quel
# file è in UTF-16 e Next lo ignora, vedi STATO.md). Entrambi sono ignorati
# da git: i valori veri stanno SOLO lì. In produzione: variabili su Netlify.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
DB_PASSWORD=

# Il motore di Rivolio
AERODATABOX_API_KEY=  # dati volo, fonte primaria (RapidAPI). SENZA chiave gira il fornitore demo
AVIATIONSTACK_API_KEY=  # dati volo, fonte di riserva (facoltativa)
MOTORE_SEGRETO=       # protegge /api/motore/* in produzione (intestazione x-motore-segreto)
SHADOW_MODE=1         # 1 = ogni verdetto idoneo aspetta la conferma umana in /admin (SPEC §4)

# Pagamenti (Polar, Merchant of Record)
POLAR_CHECKOUT_PRATICA=   # URL del checkout link "1 pratica 14,90"
POLAR_CHECKOUT_FAMIGLIA=  # URL del checkout link "famiglia 24,90"
POLAR_WEBHOOK_SECRET=     # firma del webhook ordini
POLAR_ACCESS_TOKEN=       # per le API (rimborsi garanzia, più avanti)

# Consegna
RESEND_API_KEY=
RESEND_HOOK_SECRET=   # gancio "Send Email" di Supabase -> /api/posta-auth

# Dopo il dominio (facoltative)
# RESEND_MITTENTE=Rivolio <ciao@DOMINIO>
# NEXT_PUBLIC_SITO=https://rivoglio.netlify.app

# Eredità viaggi (il vecchio motore resta nel codice ma non gira più)
EXA_API_KEY=
TELEGRAM_BOT_TOKEN=
