# Le chiavi vive stanno in .env.development.local (NON in .env.local: quel
# file è in UTF-16 e Next lo ignora, vedi STATO.md). Entrambi sono ignorati
# da git: i valori veri stanno SOLO lì. In produzione: variabili su Netlify.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
DB_PASSWORD=

# Il motore
EXA_API_KEY=          # raccolta offerte dal web
MOTORE_SEGRETO=       # protegge /api/motore/* in produzione (intestazione x-motore-segreto)

# Consegna
RESEND_API_KEY=
RESEND_HOOK_SECRET=   # gancio "Send Email" di Supabase -> /api/posta-auth
TELEGRAM_BOT_TOKEN=

# Dopo il dominio (facoltative)
# RESEND_MITTENTE=Viaggio Anche Io <ciao@viaggioancheio.it>
# NEXT_PUBLIC_SITO=https://viaggioancheio.it

POLAR_ACCESS_TOKEN=
